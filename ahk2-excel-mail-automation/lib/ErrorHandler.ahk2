#Requires AutoHotkey v2.0
#Include Config.ahk2
#Include Logger.ahk2
;==============================================================
; ErrorHandler.ahk2
; 업무별 오류처리 정책을 한 곳에서 관리한다.
;  - 라운드(필터값 1건) 처리 실패: 재시도 후에도 실패하면
;    사용자에게 "건너뛰기/전체중단"을 묻는다.
;  - 준비 단계(입력, 엑셀 연결 등) 실패: 즉시 알리고 종료한다.
;==============================================================

class ErrorHandler {
    ; 라운드 재시도가 모두 실패했을 때 호출한다.
    ; 반환값: "skip" (다음 라운드로 진행) / "abort" (전체 중단)
    static AskSkipOrAbort(idx, value, err) {
        Logger.Error(Format("[{1}] 필터값 '{2}' 처리 실패(재시도 초과): {3}", idx, value, err.Message))
        result := MsgBox(
            Format("{1}번째 라운드(필터값: {2}) 처리에 반복 실패했습니다.`n`n{3}`n`n이 라운드를 건너뛰고 계속할까요?`n(아니오 선택 시 전체 자동화를 중단합니다)"
                , idx, value, err.Message),
            "오류 발생", "YesNo Icon!")
        return (result = "Yes") ? "skip" : "abort"
    }

    ; 입력/엑셀연결 등 준비 단계에서 복구 불가능한 오류
    static Fatal(msg) {
        Logger.Error("FATAL: " msg)
        MsgBox(msg, "치명적 오류", "Icon!")
    }
}
